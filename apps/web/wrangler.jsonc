{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "regit-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"durable_objects": {
		"bindings": [{ "name": "REPOS", "class_name": "RepoCoordinator", "script_name": "regit-forge" }]
	},
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "regit" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regit",
			"database_id": "42902469-4868-49b8-8155-f952e93d8a4f"
		}
	],
	"observability": { "enabled": true },
	"vars": {
		"ACCESS_TEAM_DOMAIN": "jweilage.cloudflareaccess.com",
		"ACCESS_AUD": "ff8b8b91220e5b72efdf15fa0513dfae74669b1fc2768cb85aca75d88583bb64",
		"GIT_HOST": "git.regit.dev"
	},
	"routes": [{ "pattern": "regit.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true
}
