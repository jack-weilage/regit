{
	"name": "@regit/web",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && wrangler dev --port 4173",
		"deploy": "vite build && wrangler deploy",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p test",
		"gen": "wrangler types",
		"prepare": "wrangler types && svelte-kit sync || true",
		"test": "vitest run"
	},
	"dependencies": {
		"@regit/core": "workspace:*",
		"@regit/db": "workspace:*",
		"@regit/ui": "workspace:*",
		"drizzle-orm": "catalog:",
		"jose": "^6.2.12",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^5.0.3",
		"wrangler": "catalog:"
	}
}
