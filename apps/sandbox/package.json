{
	"name": "@regit/sandbox",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "SANDBOX_ROOT=.workspace bun --watch src/main.ts",
		"image": "docker build --platform linux/amd64 -t regit-sandbox .",
		"check": "tsc",
		"test": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 bun test --parallel"
	},
	"devDependencies": {
		"@regit/agent": "workspace:*",
		"@types/bun": "latest",
		"typescript": "catalog:"
	}
}
