{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "regit-forge",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"workers_dev": false,
	"vars": { "AI_GATEWAY": "regit" },
	"ai": { "binding": "AI", "remote": true },
	"services": [{ "binding": "MODELS", "service": "regit-forge", "entrypoint": "Models" }],
	"durable_objects": {
		"bindings": [{ "name": "ATTEMPTS", "class_name": "AttemptSandbox" }]
	},
	"exports": {
		"AttemptSandbox": { "type": "durable-object", "storage": "sqlite", "container": "sandbox" }
	},
	"containers": [
		{
			"name": "sandbox",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "../sandbox/Dockerfile" } }
		}
	]
}
