{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "regit-forge",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"workers_dev": false,
	"routes": [
		{ "pattern": "git.regit.dev/*", "zone_name": "regit.dev" },
		{ "pattern": "*.regit.run/*", "zone_name": "regit.run" }
	],
	"preview_urls": false,
	"vars": {
		"AI_GATEWAY": "regit",
		"SANDBOX_URL": "",
		"PREVIEW_DOMAIN": "regit.run",
		"GIT_HOST": "git.regit.dev",
		"RETRY_DELAY_SCALE": "1"
	},
	"ai": { "binding": "AI", "remote": true },
	"services": [{ "binding": "MODELS", "service": "regit-forge", "entrypoint": "Models" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regit",
			"database_id": "42902469-4868-49b8-8155-f952e93d8a4f",
			"migrations_dir": "../../packages/db/drizzle",
			"migrations_pattern": "../../packages/db/drizzle/*/migration.sql"
		}
	],
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "regit" }],
	"workflows": [
		{ "name": "regit-repo-pushed", "binding": "REPO_PUSHED", "class_name": "RepoPushed" },
		{ "name": "regit-ship-thread", "binding": "SHIP_THREAD", "class_name": "ShipThread" },
		{ "name": "regit-verify-main", "binding": "VERIFY_MAIN", "class_name": "VerifyMain" },
		{ "name": "regit-revert-ship", "binding": "REVERT_SHIP", "class_name": "RevertShip" }
	],
	"triggers": {
		"events": [
			{
				"type": "cf.artifacts.repo.pushed",
				"filter": { "namespace": "regit" },
				"targets": [{ "type": "workflow", "workflow_name": "regit-repo-pushed" }]
			}
		]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ATTEMPTS", "class_name": "AttemptSandbox" },
			{ "name": "REPOSITORY_GIT", "class_name": "RepositoryGit" },
			{ "name": "REPOS", "class_name": "RepoCoordinator" },
			{ "name": "MAIN", "class_name": "MainSandbox" }
		]
	},
	"exports": {
		"AttemptSandbox": { "type": "durable-object", "storage": "sqlite", "container": "sandbox" },
		"RepositoryGit": {
			"type": "durable-object",
			"storage": "sqlite",
			"container": "repository-git"
		},
		"RepoCoordinator": { "type": "durable-object", "storage": "sqlite" },
		"MainSandbox": { "type": "durable-object", "storage": "sqlite", "container": "main-sandbox" }
	},
	"containers": [
		{
			"name": "sandbox",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "../sandbox/Dockerfile" } }
		},
		{
			"name": "repository-git",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "../sandbox/Dockerfile" } }
		},
		{
			"name": "main-sandbox",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "../sandbox/Dockerfile" } }
		}
	]
}
