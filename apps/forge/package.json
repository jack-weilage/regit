{
	"name": "@regit/forge",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler d1 migrations apply regit --local --persist-to ../../.wrangler/state && wrangler dev --persist-to ../../.wrangler/state",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy && wrangler d1 migrations apply regit --remote",
		"check": "wrangler types && tsc && tsc -p test",
		"gen": "wrangler types",
		"prepare": "wrangler types || true",
		"test": "vitest run"
	},
	"dependencies": {
		"@regit/agent": "workspace:*",
		"@regit/core": "workspace:*",
		"@regit/db": "workspace:*",
		"drizzle-orm": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "^5.0.3",
		"wrangler": "catalog:"
	}
}
