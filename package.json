{
	"name": "regit",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@sveltejs/adapter-cloudflare": "^8.0.0",
			"@sveltejs/kit": "^3.0.0",
			"@sveltejs/vite-plugin-svelte": "^7.3.1",
			"@types/node": "^26.6.4",
			"drizzle-kit": "1.0.0-rc.4",
			"drizzle-orm": "1.0.0-rc.4",
			"svelte": "^5.57.1",
			"svelte-check": "^4.7.6",
			"typescript": "^6.0.3",
			"vite": "^8.3.2",
			"wrangler": "^4.146.0"
		}
	},
	"scripts": {
		"dev": "bun run --filter @regit/forge --filter @regit/web --parallel dev",
		"storybook": "bun run --filter @regit/ui storybook",
		"build": "bun run --filter '*' build",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test",
		"gen": "bun run --filter '*' gen",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"lefthook": "^2.1.16",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1"
	}
}
